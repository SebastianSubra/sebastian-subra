@startuml

package "com.example.model" {

    class Article {
        - nombre : String
        - cantidad : int
        - precio : double
        - descuento : double

        + Article(String, int, double, double)
        + getNombre() : String
        + getCantidad() : int
        + getPrecio() : double
        + getDescuento() : double
        + setCantidad(int)
        + setDescuento(double)
        + getGrossAmount() : double
        + getDiscountedAmount() : double
    }

    class Order {
        - id : String
        - articulos : List<Article>

        + Order(String)
        + getId() : String
        + getArticulos() : List<Article>
        + getGrossTotal() : double
        + getDiscountedTotal() : double
    }

    class OrderRepository {
        {static} loadOrders() : List<Order>
        {static} saveOrders(orders : List<Order>)
    }

    class CurrencyService {
        {static} getEURtoUSD() : double
    }
}

Order "1" --> "*" Article : contains

@enduml
